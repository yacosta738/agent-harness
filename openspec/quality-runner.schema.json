{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quality-runner/v1",
  "title": "Standalone SDD quality runner manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "capabilities"],
  "properties": {
    "version": { "const": "quality-runner/v1" },
    "enabled": { "type": "boolean", "default": true },
    "control_plane": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "policy": { "type": "string", "minLength": 1 },
        "toolchain_lock": { "type": "string", "minLength": 1 }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directory": { "type": "string", "minLength": 1 },
        "max_output_bytes": { "type": "integer", "minimum": 1 },
        "max_artifact_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "redaction": { "$ref": "#/$defs/redaction" },
    "capabilities": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/capability" }
    },
    "capability_registry": { "$ref": "#/$defs/capability_registry" }
  },
  "$defs": {
    "capability_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "entries"],
      "properties": {
        "version": { "const": "capability-registry/v1" },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/registry_entry" } }
      }
    },
    "registry_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "metric", "provider", "provider_version", "digest", "adapter", "semantics", "scopes", "policy"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "metric": { "enum": ["tests", "lint", "coverage"] },
        "provider": { "type": "string", "minLength": 1 },
        "provider_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
        "digest": { "type": "string", "pattern": "^(?:sha256:)?[0-9a-fA-F]{64}$" },
        "adapter": { "type": "string", "minLength": 1 },
        "semantics": { "type": "string", "minLength": 1 },
        "scopes": { "type": "array", "minItems": 1, "items": { "enum": ["project", "changed-files"] } },
        "policy": { "enum": ["required", "preferred", "disabled"] }
      }
    },
    "metrics_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "metric", "adapter", "provider", "provider_version", "semantics", "scope", "raw", "normalized", "artifacts", "status", "reason", "identity", "provenance"],
      "properties": {
        "version": { "const": "metrics/v1" },
        "metric": { "enum": ["tests", "lint", "coverage"] },
        "adapter": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "provider_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
        "semantics": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["project", "changed-files"] },
        "raw": { "type": "object" },
        "normalized": { "type": "object" },
        "artifacts": { "type": "array" },
        "status": { "enum": ["PASS", "FAIL", "BLOCKED", "UNAVAILABLE", "NOT_TESTED"] },
        "reason": { "type": ["string", "null"] },
        "identity": { "type": "object" },
        "provenance": { "type": "object" }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "values": { "type": "array", "items": { "type": "string" } },
        "patterns": { "type": "array", "items": { "type": "string" } }
      }
    },
    "shell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "reason"],
      "properties": {
        "enabled": { "const": true },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["none", "json", "regex"] },
        "source": { "enum": ["stdout", "stderr"] },
        "path": { "type": "string" },
        "pattern": { "type": "string" },
        "flags": { "type": "string" },
        "equals": {},
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cwd", "timeout_ms", "env_allowlist", "exit_codes"],
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "command": { "type": "string", "minLength": 1 },
        "shell": { "$ref": "#/$defs/shell" },
        "cwd": { "type": "string", "minLength": 1 },
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "env_allowlist": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } },
        "exit_codes": { "type": "array", "minItems": 1, "items": { "type": "integer" } },
        "parser": { "$ref": "#/$defs/parser" },
        "thresholds": { "type": "object" },
        "artifacts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "redaction": { "$ref": "#/$defs/redaction" },
        "max_output_bytes": { "type": "integer", "minimum": 1 },
        "max_artifact_bytes": { "type": "integer", "minimum": 1 },
        "required": { "type": "boolean" },
        "blocking": { "type": "boolean" },
        "skip_reason": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        { "required": ["argv"], "not": { "required": ["command"] } },
        { "required": ["command", "shell"] }
      ]
    }
  }
}
