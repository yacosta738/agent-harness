# ===========================================
# Agent Harness — Environment Variables
# ===========================================
# Copy this file to .env.local and customize values.
# All sensitive values should go in .env.local (gitignored).

# --- MCP Server URLs (optional) ---

# n8n MCP server URL (disabled by default)
# Default: https://n8n.example.com/mcp-server/http
# N8N_MCP_URL=https://your-n8n.example.com/mcp-server/http

# Custom AI router base URL
# Default: https://api.openai.com/v1 (direct to OpenAI, no custom routing)
# ROOK_BASE_URL=https://your-router.example.com/v1

# --- AI Provider Keys ---

# API key for the AI router/provider (required if using custom ROOK_BASE_URL)
# ROOK_API_KEY=your-router-api-key

# Direct provider keys (only needed if NOT using a router)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# --- MCP Server Tokens ---

# n8n MCP auth token (if using n8n)
# N8N_MCP_AUTH_TOKEN=your-n8n-token

# --- MCP Integrations (enable in opencode.json by setting enabled: true) ---

# Context7 documentation (context7.com)
# CONTEXT7_API_KEY=your-context7-api-key

# GitHub integration
# GITHUB_TOKEN=ghp_...  (classic PAT or fine-grained token)

# Stitch (Google AI code assist)
# STITCH_API_KEY=your-stitch-api-key

# --- Observability & Monitoring ---

# Sentry (error tracking)
# SENTRY_AUTH_TOKEN=sntrys_...
# SENTRY_BASE_URL=https://sentry.io (default)
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug

# Grafana (metrics dashboards)
# GRAFANA_URL=https://grafana.example.com
# GRAFANA_SERVICE_ACCOUNT_TOKEN=your-grafana-token

# SonarQube (code quality)
# SONARQUBE_TOKEN=your-sonarqube-token
# SONARQUBE_URL=https://sonarqube.example.com
# SONARQUBE_ORG=your-org

# --- AI/ML ---

# Hugging Face (models, datasets, training, jobs)
# HF_TOKEN=hf_...

# Vercel (deployments, env vars)
# VERCEL_TOKEN=your-vercel-token
