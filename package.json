{
  "name": "agent-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "deploy": "node scripts/deploy.mjs",
    "deploy:all": "node scripts/deploy.mjs all",
    "deploy:opencode": "node scripts/deploy.mjs --target opencode",
    "deploy:claude-code": "node scripts/deploy.mjs --target claude-code",
    "deploy:junie": "node scripts/deploy.mjs --target junie",
    "deploy:antigravity": "node scripts/deploy.mjs --target antigravity",
    "validate": "node scripts/check-refs.mjs",
    "list": "node scripts/generate-bundle.mjs list",
    "render": "node scripts/generate-bundle.mjs render",
    "render:all": "node scripts/generate-bundle.mjs render-all",
    "test:antigravity": "node --test tests/antigravity-distribution.test.mjs"
  }
}
