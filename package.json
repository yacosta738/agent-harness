{
  "name": "agent-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "deploy": "node scripts/deploy.mjs",
    "validate": "node scripts/check-refs.mjs",
    "test:refs": "node --test tests/check-refs.test.mjs",
    "test:sdd": "node --test tests/sdd-agents.test.mjs",
    "test:review": "node --test tests/review-command.test.mjs tests/review-lib.test.mjs",
    "test:language": "node --test tests/language.test.mjs",
    "test": "npm run test:refs && npm run test:sdd && npm run test:review && npm run test:language",
    "list": "node scripts/generate-bundle.mjs list",
    "render": "node scripts/generate-bundle.mjs render"
  }
}
