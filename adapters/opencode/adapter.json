{
  "version": "agent-harness.adapter/v1",
  "name": "opencode",
  "defaultTarget": "~/.config/opencode",
  "allowedLayers": ["portable", "adapter", "runtime"],
  "defaultPreset": "recommended",
  "presetOrder": ["minimal", "recommended", "full"],
  "components": {
    "core": {
      "include": [
        "agents/ORCHESTRATOR.md",
        "agents/acs/WRITING_STYLE.md",
        "README.md",
        "harness.config.json",
        "adapters/opencode/adapter.json",
        "adapters/opencode/tui.json"
      ]
    },
    "skills": {
      "include": [
        "skills/**",
        "commands/**"
      ]
    },
    "permissions": {
      "include": [
        "adapters/opencode/opencode.json"
      ]
    },
    "persona": {
      "include": [
        "agents/ORCHESTRATOR.md",
        "agents/acs/WRITING_STYLE.md",
        "adapters/opencode/opencode.json"
      ]
    },
    "delegation": {
      "include": [
        "commands/**/*.md",
        "agents/team/**",
        "agents/linear-pm.md",
        "skills/workflow/**"
      ]
    },
    "engram": {
      "include": [
        "agents/**",
        "skills/**"
      ]
    },
    "context7": {
      "include": [
        "agents/**",
        "skills/**"
      ]
    },
    "sdd": {
      "include": [
        "commands/sdd-*.md",
        "agents/sdd/**",
        "skills/sdd/**",
        "skills/workflow/**"
      ]
    },
    "rdd": {
      "include": [
        "adapters/opencode/scripts/review.mjs",
        "adapters/opencode/scripts/review-lib.mjs"
      ]
    },
    "judgment-day": {
      "include": [
        "agents/lens.md",
        "agents/mirror.md",
        "agents/scalpel.md",
        "skills/workflow/double-blind-review/**"
      ]
    },
    "theme": {
      "include": [
        "adapters/opencode/themes/**",
        "adapters/opencode/tui.json"
      ]
    },
    "integrations": {
      "include": [
        "adapters/opencode/scripts/**",
        "adapters/opencode/themes/**",
        "adapters/opencode/plugins/**",
        "adapters/opencode/tui.json"
      ]
    }
  },
  "presets": {
    "minimal": ["core", "skills", "permissions", "persona"],
    "recommended": ["core", "skills", "permissions", "persona", "delegation", "engram", "context7", "sdd", "rdd", "judgment-day"],
    "full": ["core", "skills", "permissions", "persona", "delegation", "engram", "context7", "sdd", "rdd", "judgment-day", "theme", "integrations"]
  }
}
