{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "plugin": [
    "opencode-wakatime",
    "opencode-gemini-auth@latest",
    "@warp-dot-dev/opencode-warp",
    "openpencil-skill@git+https://github.com/zseven-w/openpencil-skill.git"
  ],
  "permission": {
    "bash": {
      "*": "allow",
      "git commit *": "ask",
      "git push": "ask",
      "git push *": "ask",
      "git push --force *": "ask",
      "git rebase *": "ask",
      "git reset --hard *": "ask"
    },
    "read": {
      "*": "allow",
      "**/*.key": "deny",
      "**/*.pem": "deny",
      "**/.aws/credentials": "deny",
      "**/.config/gh/hosts.yml": "deny",
      "**/.credentials/**": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.ssh/**": "deny",
      "**/Library/Keychains/**": "deny",
      "**/credentials.json": "deny",
      "**/secrets/**": "deny",
      "*.env": "deny",
      "*.env.*": "deny"
    }
  },
  "mcp": {
    "engram": {
      "command": [
        "engram",
        "mcp",
        "--tools=agent"
      ],
      "enabled": true,
      "type": "local"
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    },
    "ahrefs": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://api.ahrefs.com/mcp/mcp"
      ],
      "enabled": false
    },
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "enabled": false,
      "headers": {
        "X-Goog-Api-Key": "{env:STITCH_API_KEY}"
      }
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "semgrep": {
      "type": "local",
      "command": [
        "semgrep",
        "mcp"
      ],
      "enabled": true
    },
    "cloudflare-api": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": false,
      "oauth": {}
    },
    "linear": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/mcp"
      ],
      "enabled": false
    },
    "notion": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://mcp.notion.com/mcp"
      ],
      "enabled": false
    },
    "n8n": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "supergateway",
        "--streamableHttp",
        "https://n8n.ahome.quest/mcp-server/http",
        "--header",
        "authorization:Bearer {env:N8N_MCP_AUTH_TOKEN}"
      ],
      "enabled": false
    },
    "sonarqube": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "exec \"$HOME/.config/opencode/scripts/wrap-sonarqube-mcp.sh\" \"$@\"",
        "wrap-sonarqube-mcp"
      ],
      "environment": {
        "SONARQUBE_TOKEN": "{env:SONARQUBE_TOKEN}",
        "SONARQUBE_URL": "{env:SONARQUBE_URL}",
        "SONARQUBE_ORG": "{env:SONARQUBE_ORG}"
      },
      "enabled": false
    },
    "markitdown": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "--rm",
        "-i",
        "-v",
        "/workdir",
        "markitdown-mcp:latest"
      ],
      "enabled": false
    },
    "jetbrains": {
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "http://localhost:64342/sse"
      ],
      "type": "local",
      "enabled": false
    },
    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com",
      "enabled": false
    },
    "GitGuardianDeveloper": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/GitGuardian/gg-mcp.git",
        "developer-mcp-server"
      ],
      "enabled": false
    },
    "socket-mcp": {
      "type": "remote",
      "url": "https://mcp.socket.dev/",
      "enabled": true
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "openpencil": {
      "type": "local",
      "command": [
        "openpencil-mcp"
      ],
      "enabled": true
    },
    "grafana": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-grafana"
      ],
      "environment": {
        "GRAFANA_URL": "{env:GRAFANA_URL}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "{env:GRAFANA_SERVICE_ACCOUNT_TOKEN}"
      },
      "enabled": false
    },
    "resend": {
      "type": "remote",
      "url": "https://mcp.resend.com/mcp",
      "enabled": false
    }
  },
  "agent": {
    "kerrigan": {
      "mode": "primary",
      "description": "Fullstack architect and SDD orchestrator - Cuban style, warm mentor",
      "prompt": "{file:./prompts/ORCHESTRATOR.md}\n\n{file:./prompts/acs/WRITING_STYLE.md}",
      "permission": {
        "task": {
          "*": "deny",
          "scalpel": "allow",
          "lens": "allow",
          "mirror": "allow",
          "sdd-apply": "allow",
          "sdd-archive": "allow",
          "sdd-qa": "allow",
          "sdd-design": "allow",
          "sdd-explore": "allow",
          "sdd-init": "allow",
          "sdd-onboard": "allow",
          "sdd-propose": "allow",
          "sdd-spec": "allow",
          "sdd-tasks": "allow",
          "sdd-verify": "allow"
        }
      },
      "tools": {
        "read": true,
        "search": true,
        "bash": true,
        "write": true,
        "edit": true,
        "delegate": true,
        "delegation_read": true,
        "delegation_list": true
      },
      "subagents": {
        "tech-lead": {
          "description": "Tech Lead - Architecture and technical leadership",
          "prompt": "{file:./prompts/team/tech-lead.md}"
        },
        "senior-dev": {
          "description": "Senior Developer - Implementation and code quality",
          "prompt": "{file:./prompts/team/senior-dev.md}"
        },
        "devops-engineer": {
          "description": "DevOps Engineer - CI/CD and Infrastructure",
          "prompt": "{file:./prompts/team/devops-engineer.md}"
        },
        "qa-engineer": {
          "description": "QA Engineer - Testing and quality",
          "prompt": "{file:./prompts/team/qa-engineer.md}"
        },
        "security-engineer": {
          "description": "Security Engineer - Security and compliance",
          "prompt": "{file:./prompts/team/security-engineer.md}"
        },
        "product-manager": {
          "description": "Product Manager - Vision and prioritization",
          "prompt": "{file:./prompts/team/product-manager.md}"
        },
        "code-reviewer": {
          "description": "Code Reviewer - Thorough reviews",
          "prompt": "{file:./prompts/team/code-reviewer.md}"
        },
        "performance-engineer": {
          "description": "Performance Engineer - Optimization and scalability",
          "prompt": "{file:./prompts/team/performance-engineer.md}"
        },
        "ux-designer": {
          "description": "UX Designer - User experience",
          "prompt": "{file:./prompts/team/ux-designer.md}"
        },
        "data-engineer": {
          "description": "Data Engineer - Data and analytics",
          "prompt": "{file:./prompts/team/data-engineer.md}"
        }
      }
    },
    "linear-pm": {
      "mode": "subagent",
      "description": "Project management specialist for Linear - manages issues, projects, and tracks progress",
      "prompt": "{file:./prompts/linear-pm.md}",
      "tools": {
        "read": true,
        "search": true
      }
    },
    "sdd-apply": {
      "description": "Implement code changes from task definitions",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:./prompts/sdd/sdd-apply.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "read": true,
        "write": true
      }
    },
    "sdd-archive": {
      "description": "Archive completed change artifacts",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:./prompts/sdd/sdd-archive.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "read": true,
        "write": true
      }
    },
    "sdd-qa": {
      "description": "Run capability-driven acceptance QA and write qa-report.md",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:./prompts/sdd/sdd-qa.md}",
      "tools": {
        "bash": true,
        "read": true,
        "write": true
      }
    },
    "sdd-design": {
      "description": "Create technical design from proposals",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:./prompts/sdd/sdd-design.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "read": true,
        "write": true
      }
    },
    "sdd-explore": {
      "description": "Investigate codebase and think through ideas",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:./prompts/sdd/sdd-explore.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "read": true,
        "write": true
      }
    },
    "sdd-init": {
      "description": "Bootstrap SDD context and project configuration",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:./prompts/sdd/sdd-init.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "read": true,
        "write": true
      }
    },
    "sdd-propose": {
      "description": "Create change proposals from explorations",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:./prompts/sdd/sdd-propose.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "read": true,
        "write": true
      }
    },
    "sdd-spec": {
      "description": "Write detailed specifications from proposals",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:./prompts/sdd/sdd-spec.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "read": true,
        "write": true
      }
    },
    "sdd-tasks": {
      "description": "Break down specs and designs into implementation tasks",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:./prompts/sdd/sdd-tasks.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "read": true,
        "write": true
      }
    },
    "sdd-verify": {
      "description": "Validate implementation against specs",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:./prompts/sdd/sdd-verify.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "read": true,
        "write": true
      }
    },
    "scalpel": {
      "description": "Surgical fix agent for judgment-day protocol",
      "hidden": false,
      "mode": "subagent",
      "prompt": "{file:./prompts/scalpel.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "read": true,
        "write": true
      }
    },
    "lens": {
      "description": "Adversarial code reviewer — blind judge A for judgment-day protocol",
      "hidden": false,
      "mode": "subagent",
      "prompt": "{file:./prompts/lens.md}",
      "tools": {
        "bash": true,
        "read": true
      }
    },
    "mirror": {
      "description": "Adversarial code reviewer — blind judge B for judgment-day protocol",
      "hidden": false,
      "mode": "subagent",
      "prompt": "{file:./prompts/mirror.md}",
      "tools": {
        "bash": true,
        "read": true
      }
    },
    "sdd-onboard": {
      "description": "Guide users through the full SDD cycle using their real codebase",
      "hidden": false,
      "mode": "subagent",
      "prompt": "{file:./prompts/sdd/sdd-onboard.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "read": true,
        "write": true
      }
    }
  },
  "provider": {
    "rook": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "rook",
      "options": {
        "baseURL": "https://omnirouter.ahome.quest/v1",
        "apiKey": "{env:ROOK_API_KEY}"
      },
      "models": {
        "auto/best-coding": {
          "name": "auto/best-coding"
        },
        "auto/coding": {
          "name": "auto/coding"
        },
        "auto/best-reasoning": {
          "name": "auto/best-reasoning"
        },
        "auto/best-vision": {
          "name": "auto/best-vision"
        },
        "coding": {
          "name": "coding"
        },
        "free-stack": {
          "name": "free-stack"
        },
        "null": {
          "name": "null"
        },
        "gg-brain": {
          "name": "gg-brain"
        },
        "writer": {
          "name": "writer"
        },
        "ftk": {
          "name": "ftk"
        }
      }
    }
  }
}
