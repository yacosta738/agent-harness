{
  "version": "quality-runner/v1",
  "enabled": true,
  "output": { "max_output_bytes": 2048, "max_artifact_bytes": 1024 },
  "redaction": { "values": ["fixture-secret"] },
  "capabilities": {
    "pass": { "argv": ["node", "-e", "process.stdout.write('pass')"], "cwd": ".", "timeout_ms": 1000, "env_allowlist": ["PATH"], "exit_codes": [0], "artifacts": ["artifact.txt"] },
    "shell": { "command": "printf shell-pass", "shell": { "enabled": true, "reason": "fixture shell contract" }, "cwd": ".", "timeout_ms": 1000, "env_allowlist": ["PATH"], "exit_codes": [0] },
    "missing": { "argv": ["sdd-command-that-does-not-exist"], "cwd": ".", "timeout_ms": 1000, "env_allowlist": [], "exit_codes": [0] },
    "secret": { "argv": ["node", "-e", "process.stderr.write('fixture-secret diagnostic') ; process.exit(3)"], "cwd": ".", "timeout_ms": 1000, "env_allowlist": ["PATH"], "exit_codes": [0] },
    "timeout": { "argv": ["node", "-e", "setTimeout(() => {}, 5000)"], "cwd": ".", "timeout_ms": 50, "env_allowlist": ["PATH"], "exit_codes": [0] },
    "env": { "argv": ["node", "-e", "process.stdout.write(process.env.FIXTURE_SECRET || 'not-visible')"], "cwd": ".", "timeout_ms": 1000, "env_allowlist": ["PATH"], "exit_codes": [0] },
    "threshold": { "argv": ["node", "-e", "process.stdout.write('{\\\"score\\\":3}')"], "cwd": ".", "timeout_ms": 1000, "env_allowlist": ["PATH"], "exit_codes": [0], "parser": { "type": "json", "path": "score" }, "thresholds": { "min": 4 } },
    "parser": { "argv": ["node", "-e", "process.stdout.write('{\\\"ok\\\":false}')"], "cwd": ".", "timeout_ms": 1000, "env_allowlist": ["PATH"], "exit_codes": [0], "parser": { "type": "json", "path": "ok", "equals": true } },
    "skip": { "argv": ["node", "-e", "process.exit(99)"], "cwd": ".", "timeout_ms": 1000, "env_allowlist": ["PATH"], "exit_codes": [0], "enabled": false, "skip_reason": "fixture intentional skip" }
  }
}
